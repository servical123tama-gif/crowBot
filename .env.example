# Database
DATABASE_URL=sqlite:///./barbershop.db
# atau: postgresql://user:pass@localhost:5432/barbershop_db

# Dashboard (Flask) — WAJIB
# Generate: py -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_PWD'))"
DASHBOARD_PASSWORD_HASH=
# Generate: py -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=
# HMAC key untuk QR public link — WAJIB (jangan pakai default)
SECRET_KEY=
# Port dashboard (dibaca oleh run_dashboard.py sebagai PORT)
PORT=5000

# Application Settings
# DEBUG=False artinya SESSION_COOKIE_SECURE aktif (butuh HTTPS via Cloudflare Tunnel).
# Ubah ke True HANYA saat dev di localhost tanpa HTTPS.
DEBUG=False
LOG_LEVEL=INFO
CURRENCY=Rp
TIMEZONE=Asia/Jakarta

# WhatsApp gateway (Fonnte) — untuk kirim QR member otomatis
FONNTE_TOKEN={your_fonnte_token_here}

# URL publik app (dipakai untuk generate link QR di WA)
APP_BASE_URL=https://your-domain.com
